# SAOS-DEX local secrets — NEVER commit real values
DATABASE_URL=file:../db/dex.db

# ── Relay (עיגון לשרשראות-ציבוריות) — ערכים אמיתיים רק ב-.env (gitignored) ──
# חשבון-העוגן הראשי (Steem): חתימה על כל-חותם
SAOS_RELAY_AGENT_ACCOUNT=
STEEM_ACTIVE_WIF=
# Hive: אותו חשבון כברירת-מחדל; ניתן להפנות לחשבון-עוגן עם RC-פנוי
HIVE_ACTIVE_WIF=
HIVE_ANCHOR_ACCOUNT=
# TRON (אופציונלי): בלי מפתח — הזהות נגזרת מה-STEEM scalar והעיגון מותנה-מימון
# TRON_PRIVATE_KEY=

# ── Ethereum (EIP-1559 self-tx anchor, calldata=payload) ──
# זהות secp256k1 נפרדת; כתובת-צפויה לאימות fail-closed (EIP-55)
ETH_PRIVATE_KEY=
ETH_EXPECTED_ADDRESS=
# RPC: חייב-לקבל בקשות fetch ללא User-Agent (blxrbdn אומת; publicnode/drpc חוסמים)
ETH_RPC_URL=https://eth.rpc.blxrbdn.com
# שער-שידור-חי (המפעיל): "1"|"true" מפעיל שידור-אמת (גז-אמת) — כל-עוד כבוי: כוונות-EIP-191 בלבד
ETH_BROADCAST_ENABLED=false

# ── Solana (SPL-Memo v2 anchor, fee-payer=self) ──
# זהות ed25519 (seed 32-byte hex); כתובת-base58 צפויה לאימות fail-closed
SOL_PRIVATE_KEY=
SOL_EXPECTED_ADDRESS=
# mainnet-beta לעיגון-אמת; devnet לקרקע-הוכחה אפס-עלות
SOL_RPC_URL=https://api.mainnet-beta.solana.com
# שער-שידור-חי (המפעיל): "1"|"true" מפעיל שידור-אמת (5000 lamports/חתימה)
SOL_BROADCAST_ENABLED=false
