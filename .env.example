# SAOS-DEX local secrets — NEVER commit real values
DATABASE_URL=file:../db/dex.db

# ── Relay (עיגון לשרשראות-ציבוריות) — ערכים אמיתיים רק ב-.env (gitignored) ──
# חשבון-העוגן הראשי (Steem): חתימה על כל-חותם
SAOS_RELAY_AGENT_ACCOUNT=
STEEM_ACTIVE_WIF=
# Hive: אותו חשבון כברירת-מחדל; ניתן להפנות לחשבון-עוגן עם RC-פנוי
HIVE_ACTIVE_WIF=
HIVE_ANCHOR_ACCOUNT=
# TRON (אופציונלי): בלי מפתח — הזהות נגזרת מה-STEEM scalar והעיגון מותנה-מימון
# TRON_PRIVATE_KEY=
